# Copiez ce fichier en .env pour lancer en local. En production, définissez ces variables sur wedeploy.
# Adresse de la base PostgreSQL (utilisez le compte limité kickflow_app, pas postgres)
DATABASE_URL=postgres://kickflow_app:MOT_DE_PASSE@HOTE:PORT/kickflow_db
# true si votre hébergeur de base impose une connexion chiffrée
DATABASE_SSL=false
# Clé secrète des sessions : 48 caractères aléatoires minimum, à garder secrète
JWT_SECRET=remplacez-moi-par-une-longue-chaine-aleatoire
# Emails des arbitres (séparés par des virgules) : ils peuvent trancher les litiges
ADMIN_EMAILS=
# Bonus de bienvenue en XOF
SIGNUP_BONUS=100
# Port d'écoute (souvent fourni automatiquement par l'hébergeur)
PORT=8787

# --- Adresse publique de l'appli (liens dans les emails) ---
APP_URL=https://kickflow.wedeploy.tech

# --- PayPlus (ne jamais publier les valeurs réelles) ---
PAYPLUS_BASE_URL=https://app.testthepayment.com
PAYPLUS_API_KEY=
PAYPLUS_API_TOKEN=

# --- Notifications sur le téléphone (Web Push) ---
# Générer une paire : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@kickflow.app

# --- Emails (mot de passe oublié) via SMTP : Brevo, Resend, Gmail… ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Nom et adresse affichés au joueur
MAIL_FROM=KickFlow <noreply@votre-domaine>
