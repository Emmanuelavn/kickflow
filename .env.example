# Copiez ce fichier en .env pour lancer en local. En production, définissez ces variables sur wedeploy.
# Adresse de la base PostgreSQL (utilisez le compte limité kickflow_app, pas postgres)
DATABASE_URL=postgres://kickflow_app:MOT_DE_PASSE@HOTE:PORT/kickflow_db
# true si votre hébergeur de base impose une connexion chiffrée
DATABASE_SSL=false
# Clé secrète des sessions : 48 caractères aléatoires minimum, à garder secrète
JWT_SECRET=remplacez-moi-par-une-longue-chaine-aleatoire
# Emails des arbitres (séparés par des virgules) : ils peuvent trancher les litiges
ADMIN_EMAILS=
# SkillCoins offerts à l'inscription
SIGNUP_BONUS=100
# Port d'écoute (souvent fourni automatiquement par l'hébergeur)
PORT=8787
